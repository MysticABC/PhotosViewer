<Window x:Class="PhotosViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotosViewer.App"
        Title="PhotosViewer" Width="1140" Height="780" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="OptionTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <Style x:Key="PhotoCard" TargetType="Border">
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PhotoTileTemplate">
            <Border Width="{x:Static local:GalleryLayout.TileWidth}" Height="{x:Static local:GalleryLayout.TileHeight}" Padding="4">
                <Border Style="{StaticResource PhotoCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Button ToolTip="{Binding File.FullPath}" Padding="0" MinHeight="0" BorderThickness="0" Background="Transparent"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding File.Name}" Click="OnSelectPhoto" MouseDoubleClick="OnOpenPhoto"
                                PreviewKeyDown="OnPhotoTileKeyDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="17" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource ImageBrush}" CornerRadius="3" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Text" Value="正在加载…" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailFailed}" Value="True">
                                                            <Setter Property="Text" Value="无法预览" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding File.Name}" TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" Margin="4,2,4,0" />
                                <TextBlock Grid.Row="2" Text="{Binding CaptureLabel}" Style="{StaticResource MutedText}"
                                           FontSize="11" Margin="4,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <DockPanel Grid.Row="1" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FormatLabel}" Foreground="{StaticResource AccentBrush}"
                                       FontSize="11" Margin="2,0,4,0" />
                            <local:RatingEditor Value="{Binding Rating}" IsEnabled="{Binding CanEditRating}" RatingRequested="OnRatingRequested" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PhotoRowTemplate">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PhotoTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDeleting}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="49" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="20,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PhotosViewer" FontSize="20" FontWeight="SemiBold" Margin="0,0,22,0" />
                <Button Grid.Column="1" Content="打开目录…" Style="{StaticResource PrimaryButton}"
                        Height="34" ToolTip="Ctrl+O" Click="OnOpenFolder" />
                <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0" Height="34" ToolTip="F5"
                        IsEnabled="{Binding CanRefresh}" Click="OnRefreshFolder" />
                <TextBlock Grid.Column="3" Margin="16,0,0,0" Style="{StaticResource MutedText}"
                           Text="{Binding Folder, TargetNullValue=尚未选择目录}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="SelectAllAction" Content="全选" Click="OnSelectAll" IsEnabled="{Binding CanSelectAll}"
                            ToolTip="Ctrl+A 全选当前筛选结果" />
                    <Button x:Name="RecycleAction" Content="移入回收站" Click="OnRecycleSelection" IsEnabled="{Binding CanDelete}"
                            Margin="6,0,0,0" ToolTip="Delete" />
                    <Button x:Name="PermanentDeleteAction" Content="永久删除" Click="OnPermanentlyDeleteSelection" IsEnabled="{Binding CanDelete}"
                            Foreground="{StaticResource DangerBrush}" Margin="6,0,0,0" ToolTip="Shift+Delete" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20,0,20,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="226" Height="34">
                    <TextBox x:Name="SearchBox" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="搜索文件名" />
                    <TextBlock Text="搜索文件名" IsHitTestVisible="False" Margin="11,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Width="106" Height="34" Margin="8,0,0,0" ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}" ItemTemplate="{StaticResource OptionTemplate}"
                          AutomationProperties.Name="文件格式" />
                <ComboBox x:Name="RatingFilter" Width="106" Height="34" Margin="8,0,0,0" ItemsSource="{Binding RatingOptions}"
                          SelectedItem="{Binding SelectedRating}" ItemTemplate="{StaticResource OptionTemplate}"
                          AutomationProperties.Name="星级筛选" />
                <ComboBox Width="114" Height="34" Margin="16,0,0,0" ItemsSource="{Binding Sorts}"
                          SelectedItem="{Binding SelectedSort}" ItemTemplate="{StaticResource OptionTemplate}"
                          AutomationProperties.Name="排序依据" />
                <ToggleButton Width="34" Height="34" Margin="5,0,0,0" IsChecked="{Binding Descending}"
                              ToolTip="切换升序和降序" AutomationProperties.Name="降序排列">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Content" Value="↑" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="↓" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="258" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PhotoRegion" SizeChanged="OnPhotoRegionSizeChanged">
                <ItemsControl x:Name="Gallery" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PhotoRowTemplate}"
                              Margin="12,8,6,8" Focusable="True" KeyboardNavigation.TabNavigation="Once"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsViewerOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True" PanningMode="VerticalOnly" Focusable="False" ScrollChanged="OnGalleryScrollChanged">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyLabel}" FontSize="16" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPhotos}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid x:Name="Viewer" Background="{StaticResource ImageBrush}"
                      Visibility="{Binding IsViewerOpen, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="45" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="返回列表" ToolTip="Esc" Click="OnCloseViewer" Height="30" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="←" Width="33" Padding="0" ToolTip="上一张" AutomationProperties.Name="上一张"
                                        IsEnabled="{Binding CanMoveBack}" Click="OnPreviousPhoto" />
                                <TextBlock Text="{Binding ViewerPosition}" Style="{StaticResource MutedText}" Margin="8,0" />
                                <Button Content="→" Width="33" Padding="0" ToolTip="下一张" AutomationProperties.Name="下一张"
                                        IsEnabled="{Binding CanMoveForward}" Click="OnNextPhoto" />
                            </StackPanel>
                            <TextBlock Text="{Binding ViewerPhoto.File.Name}" Margin="12,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <local:PhotoViewport x:Name="PhotoSurface" />
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="11,6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewerStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ViewerStatus}" Style="{StaticResource MutedText}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:RatingEditor x:Name="ViewerRating" DataContext="{Binding ViewerPhoto}" Value="{Binding Rating}"
                                                IsEnabled="{Binding CanEditRating}" RatingRequested="OnRatingRequested"
                                                VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="适应窗口" ToolTip="0" Click="OnFitToWindow" />
                            <Button Content="原始像素" ToolTip="1" Click="OnActualPixels" Margin="6,0,0,0" />
                            <Button Content="旋转" ToolTip="R" Click="OnRotatePhoto" Margin="6,0,0,0" />
                            <TextBlock x:Name="ZoomValue" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource LineBrush}"
                    Padding="16,14,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="照片信息" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1" Text="选中照片后查看信息" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="1" Visibility="{Binding HasSelection, Converter={StaticResource BooleanVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPhoto.File.Name}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPhoto.File.Name}" />
                            <TextBlock Text="{Binding SelectedPhoto.File.FullPath}" FontSize="12" Margin="0,4,0,11"
                                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedPhoto.File.FullPath}" />
                            <Border Height="1" Background="{StaticResource LineBrush}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,5,3,5">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="1" FontSize="12.5" Text="{Binding Value}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding DetailsStatus}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="查看大图" Click="OnOpenSelectedPhoto" Height="34" Margin="0,8,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewerOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Style="{StaticResource MutedText}" FontSize="12" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionLabel}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,15,0" />
                <TextBlock Text="{Binding Activity}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
